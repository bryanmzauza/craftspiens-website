# =============================================================================
# CraftSapiens — Variáveis de Ambiente
# =============================================================================
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o .env ou qualquer arquivo com credenciais reais.
# Em produção, o servidor não inicia se alguma variável obrigatória faltar
# (validação em src/lib/env.ts).
# =============================================================================

# --- Banco de Dados: PostgreSQL (dados do site) ---
# Em desenvolvimento, suba com: docker compose up -d
POSTGRES_URL="postgresql://craftsapiens:craftsapiens_dev@localhost:5454/craftsapiens"

# --- Banco de Dados: MariaDB (somente a tabela nlogin do servidor Minecraft) ---
# Formato: mysql://usuario:senha@host:porta/nome_do_banco
DATABASE_URL="mysql://user:password@localhost:3306/craftsapiens"

# --- Auth.js (NextAuth) ---
# Gere com: openssl rand -base64 32
AUTH_SECRET="gere-um-secret-aleatorio-com-pelo-menos-32-caracteres"
# URL pública do site (sem barra final)
AUTH_URL="http://localhost:3000"

# --- Servidor Minecraft (opcional — usa defaults se ausente) ---
# MINECRAFT_SERVER_HOST="jogar.craftsapiens.com.br"
# MINECRAFT_SERVER_PORT=25565

# --- SMTP (envio de emails) ---
# Emails transacionais: recuperação de senha, boas-vindas, newsletter,
# confirmação de contato, confirmação de compra e aviso de troca de email.
SMTP_HOST="smtp.exemplo.com"
SMTP_PORT=587
# "true" para a porta 465 (TLS direto); "false" para 587 (STARTTLS obrigatório)
SMTP_SECURE="false"
SMTP_USER="seu-usuario-smtp"
SMTP_PASS="sua-senha-smtp"
SMTP_FROM="noreply@craftsapiens.com.br"

# --- MercadoPago (gateway de pagamento) ---
# Obtenha em https://www.mercadopago.com.br/developers/panel/app
MERCADOPAGO_ACCESS_TOKEN="APP_USR-0000000000000000-000000-00000000000000000000000000000000-000000000"
# Assinatura secreta dos webhooks (painel do MercadoPago > Webhooks). Obrigatória:
# sem ela o webhook recusa todas as notificações.
MERCADOPAGO_WEBHOOK_SECRET="seu-webhook-secret"
