# =============================================================================
# CraftSapiens — Variáveis de Ambiente
# =============================================================================
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA commite o .env ou qualquer arquivo com credenciais reais.
# Em produção, o servidor não inicia se alguma variável obrigatória faltar
# (validação em src/lib/env.ts).
# =============================================================================

# --- Banco de Dados: PostgreSQL (dados do site) ---
# Em desenvolvimento, suba com: docker compose up -d
POSTGRES_URL="postgresql://craftsapiens:craftsapiens_dev@localhost:5454/craftsapiens"

# --- Banco de Dados: MariaDB (somente a tabela nlogin do servidor Minecraft) ---
# Formato: mysql://usuario:senha@host:porta/nome_do_banco
DATABASE_URL="mysql://user:password@localhost:3306/craftsapiens"

# --- Auth.js (NextAuth) ---
# Gere com: openssl rand -base64 32
AUTH_SECRET="gere-um-secret-aleatorio-com-pelo-menos-32-caracteres"
# URL pública do site (sem barra final)
AUTH_URL="http://localhost:3000"

# --- Login externo (opcional) ---
# Sem estas variáveis, os botões "Entrar com Google" e "Entrar com Microsoft"
# não aparecem. Configuração em docs/login-externo.md.
# AUTH_GOOGLE_ID="....apps.googleusercontent.com"
# AUTH_GOOGLE_SECRET=""
# AUTH_MICROSOFT_ID="00000000-0000-0000-0000-000000000000"
# AUTH_MICROSOFT_SECRET=""

# --- Servidor Minecraft (opcional) ---
# Domínio consultado para o status do servidor (padrão: jogar.craftsapiens.com.br)
# MINECRAFT_SERVER_HOST="jogar.craftsapiens.com.br"
# Deixe a porta sem definir: ela é obtida do registro SRV do domínio.
# Defina só se o servidor não tiver registro SRV.
# MINECRAFT_SERVER_PORT=25565

# --- SMTP (envio de emails) ---
# Emails automáticos: confirmação de e-mail, recuperação de senha, boas-vindas,
# confirmação de contato, confirmação de compra e aviso de troca de e-mail.
# Produção: SMTP do Gmail. Passo a passo em docs/email.md.
# Teste a configuração com: npm run email:test -- destino@exemplo.com
SMTP_HOST="smtp.gmail.com"
# "true" para a porta 465 (TLS direto); "false" para 587 (STARTTLS obrigatório)
SMTP_PORT=465
SMTP_SECURE="true"
# Conta Gmail da equipe e uma senha de app (não a senha normal da conta)
SMTP_USER="conta-da-equipe@gmail.com"
SMTP_PASS="senha-de-app"
# Precisa estar confirmado em "Enviar e-mail como" na conta do SMTP_USER;
# sem isso, o Gmail troca o remetente pelo endereço da conta
SMTP_FROM="nao-responda@craftsapiens.com.br"
SMTP_FROM_NAME="CraftSapiens"
# Opcional: para onde vão as respostas aos e-mails automáticos
SMTP_REPLY_TO="contato@craftsapiens.com.br"
# Opcional: caixa da equipe que recebe as mensagens do formulário de contato
CONTACT_INBOX="contato@craftsapiens.com.br"

# --- MercadoPago (gateway de pagamento) ---
# Passo a passo em docs/mercadopago.md (Suas integrações > aplicação > Credenciais)
MERCADOPAGO_ACCESS_TOKEN="APP_USR-0000000000000000-000000-00000000000000000000000000000000-000000000"
# Assinatura secreta dos webhooks (painel do MercadoPago > Webhooks). Obrigatória:
# sem ela o webhook recusa todas as notificações.
MERCADOPAGO_WEBHOOK_SECRET="seu-webhook-secret"
# Só em desenvolvimento, com credenciais de teste: e-mail da conta de teste
# compradora (Suas integrações > aplicação > Contas de teste). Ignorado em produção.
MERCADOPAGO_TEST_PAYER_EMAIL=""
# A conta do MercadoPago precisa ter uma chave Pix cadastrada: o Pix é criado
# pela API de pagamentos e o QR Code aparece no site.

# --- Plugin de entregas da loja (servidor Minecraft) ---
# Token que o plugin usa em GET/POST /api/loja/entregas (docs/plugin-entregas.md).
# Gere com: openssl rand -hex 32. Sem ele, a API de entregas responde 503 e os
# pedidos aprovados ficam na fila.
# DELIVERY_API_TOKEN=""

# --- Aulas: vídeos do canal no YouTube (opcional) ---
# Arquivo onde `npm run aulas:atualizar` grava a lista de vídeos. Padrão:
# scripts/data/youtube-videos.json. Em produção, use um caminho fora do repositório
# para não travar o git pull (ver docs/arquitetura-producao.md, seção 6.5)
# AULAS_YOUTUBE_FILE="/var/lib/craftsapiens/youtube-videos.json"
# Comando do yt-dlp, com argumentos extras se precisar (padrão: yt-dlp ou uvx yt-dlp)
# YTDLP="/usr/local/bin/yt-dlp"
