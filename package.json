{
  "name": "craftsapiens-website",
  "version": "0.14.1",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "npm run db:generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "postinstall": "npm run db:generate",
    "db:generate": "prisma generate --config prisma.config.ts && prisma generate --config prisma.pg.config.ts",
    "db:push:pg": "prisma db push --config prisma.pg.config.ts",
    "db:seed": "npm run db:seed:aulas && npm run db:seed:blog && npm run db:seed:forum && npm run db:seed:loja",
    "db:seed:aulas": "node scripts/seed-aulas.mjs",
    "db:seed:blog": "node scripts/seed-blog.mjs",
    "db:seed:forum": "node scripts/seed-forum.mjs",
    "db:seed:loja": "node scripts/seed-loja.mjs",
    "db:migrate-v13": "node scripts/migrate-v13.mjs"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.5.0",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.5.0",
    "argon2": "^0.44.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.3.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.577.0",
    "mariadb": "^3.5.2",
    "mercadopago": "^2.12.0",
    "next": "16.2.0",
    "next-auth": "^5.0.0-beta.30",
    "nodemailer": "^7.0.7",
    "pg": "^8.20.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.0",
    "prisma": "^7.5.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
